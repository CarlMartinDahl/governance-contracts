{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governance-contracts.invalid/schemas/swe-bodelning-export-package-bundle-manifest.json",
  "title": "SWE_BODELNING Export Bundle Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "jurisdiction_profile_key",
    "package_version",
    "export_version",
    "dossier_fingerprint",
    "canonical_source",
    "generated_at",
    "artifacts"
  ],
  "properties": {
    "jurisdiction_profile_key": {
      "type": "string",
      "const": "SWE_BODELNING"
    },
    "package_version": {
      "type": "string",
      "minLength": 1
    },
    "export_version": {
      "type": "string",
      "minLength": 1
    },
    "dossier_fingerprint": {
      "type": "string",
      "minLength": 1
    },
    "canonical_source": {
      "$ref": "https://governance-contracts.invalid/schemas/swe-bodelning-profile-dossier-snapshot.json#/$defs/canonicalSource"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/bundleManifestArtifact"
      }
    }
  },
  "$defs": {
    "bundleManifestArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "filename",
        "content_type",
        "encoding"
      ],
      "properties": {
        "artifact_type": {
          "type": "string",
          "minLength": 1
        },
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "content_type": {
          "type": "string",
          "minLength": 1
        },
        "encoding": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
