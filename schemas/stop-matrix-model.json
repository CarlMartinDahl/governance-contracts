{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governance-contracts.invalid/schemas/stop-matrix-model.json",
  "title": "Stop Matrix Model Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["matrix_entries"],
  "properties": {
    "matrix_entries": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/stopMatrixEntry"
      }
    }
  },
  "$defs": {
    "stopMatrixEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition_key", "canonical_stop_outcomes"],
      "properties": {
        "condition_key": {
          "type": "string",
          "enum": [
            "missing_required_input",
            "unsupported_profile_surface_or_capability",
            "inconsistent_or_ambiguous_critical_information",
            "unsourced_or_unverified_information_offered_as_settled"
          ]
        },
        "canonical_stop_outcomes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "./stop-outcome-model.json"
          }
        }
      }
    }
  }
}
