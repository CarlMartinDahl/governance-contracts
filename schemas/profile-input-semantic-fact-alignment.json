{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governance-contracts.invalid/schemas/profile-input-semantic-fact-alignment.json",
  "title": "Profile Input Semantic Fact Alignment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "alignment_scope",
    "supported_semantic_fact_dimensions",
    "unassigned_semantic_fact_dimensions",
    "SWE_BODELNING_REQUIRED_LANE_WITH_VALUE",
    "SWE_BODELNING_REQUIRED_LANE_MARKED_MISSING",
    "CMD_PROFILE_REQUIRED_LANE_WITH_VALUE",
    "CMD_PROFILE_REQUIRED_LANE_MARKED_MISSING"
  ],
  "properties": {
    "alignment_scope": {
      "type": "string",
      "const": "presence_status_only"
    },
    "supported_semantic_fact_dimensions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "presence_status"
        ]
      },
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 1
    },
    "unassigned_semantic_fact_dimensions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "source_status",
          "verification_status",
          "dispute_status",
          "consistency_status"
        ]
      },
      "uniqueItems": true,
      "minItems": 4,
      "maxItems": 4
    },
    "SWE_BODELNING_REQUIRED_LANE_WITH_VALUE": {
      "allOf": [
        {
          "$ref": "#/$defs/semanticFactPresenceAlignmentEntry"
        },
        {
          "properties": {
            "jurisdiction_profile_key": {
              "const": "SWE_BODELNING"
            },
            "case_key": {
              "const": "required_lane_with_value"
            },
            "input_contract_references": {
              "items": {
                "enum": [
                  "profile_input_lane_snapshot.*.has_value",
                  "profile_input_summary.required_lane_count",
                  "profile_input_summary.lanes_with_value_count",
                  "profile_input_summary.missing_value_lane_keys"
                ]
              },
              "minItems": 4,
              "maxItems": 4
            },
            "canonical_semantic_fact": {
              "allOf": [
                {
                  "$ref": "#/$defs/presenceOnlySemanticFact"
                },
                {
                  "properties": {
                    "presence_status": {
                      "const": "present"
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "SWE_BODELNING_REQUIRED_LANE_MARKED_MISSING": {
      "allOf": [
        {
          "$ref": "#/$defs/semanticFactPresenceAlignmentEntry"
        },
        {
          "properties": {
            "jurisdiction_profile_key": {
              "const": "SWE_BODELNING"
            },
            "case_key": {
              "const": "required_lane_marked_missing"
            },
            "input_contract_references": {
              "items": {
                "enum": [
                  "profile_input_lane_snapshot.*.has_value",
                  "profile_input_summary.required_lane_count",
                  "profile_input_summary.lanes_with_value_count",
                  "profile_input_summary.missing_value_lane_keys"
                ]
              },
              "minItems": 4,
              "maxItems": 4
            },
            "canonical_semantic_fact": {
              "allOf": [
                {
                  "$ref": "#/$defs/presenceOnlySemanticFact"
                },
                {
                  "properties": {
                    "presence_status": {
                      "const": "missing"
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "CMD_PROFILE_REQUIRED_LANE_WITH_VALUE": {
      "allOf": [
        {
          "$ref": "#/$defs/semanticFactPresenceAlignmentEntry"
        },
        {
          "properties": {
            "jurisdiction_profile_key": {
              "const": "CMD_PROFILE"
            },
            "case_key": {
              "const": "required_lane_with_value"
            },
            "input_contract_references": {
              "items": {
                "enum": [
                  "profile_input_lane_snapshot.*.has_value",
                  "profile_input_summary.required_lane_count",
                  "profile_input_summary.lanes_with_value_count",
                  "profile_input_summary.missing_value_lane_keys"
                ]
              },
              "minItems": 4,
              "maxItems": 4
            },
            "canonical_semantic_fact": {
              "allOf": [
                {
                  "$ref": "#/$defs/presenceOnlySemanticFact"
                },
                {
                  "properties": {
                    "presence_status": {
                      "const": "present"
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "CMD_PROFILE_REQUIRED_LANE_MARKED_MISSING": {
      "allOf": [
        {
          "$ref": "#/$defs/semanticFactPresenceAlignmentEntry"
        },
        {
          "properties": {
            "jurisdiction_profile_key": {
              "const": "CMD_PROFILE"
            },
            "case_key": {
              "const": "required_lane_marked_missing"
            },
            "input_contract_references": {
              "items": {
                "enum": [
                  "profile_input_lane_snapshot.*.has_value",
                  "profile_input_summary.required_lane_count",
                  "profile_input_summary.lanes_with_value_count",
                  "profile_input_summary.missing_value_lane_keys"
                ]
              },
              "minItems": 4,
              "maxItems": 4
            },
            "canonical_semantic_fact": {
              "allOf": [
                {
                  "$ref": "#/$defs/presenceOnlySemanticFact"
                },
                {
                  "properties": {
                    "presence_status": {
                      "const": "missing"
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "presenceOnlySemanticFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "presence_status"
      ],
      "properties": {
        "presence_status": {
          "$ref": "./semantic-fact-model.json#/properties/presence_status"
        }
      }
    },
    "semanticFactPresenceAlignmentEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jurisdiction_profile_key",
        "case_key",
        "input_contract_references",
        "canonical_semantic_fact"
      ],
      "properties": {
        "jurisdiction_profile_key": {
          "type": "string",
          "enum": [
            "SWE_BODELNING",
            "CMD_PROFILE"
          ]
        },
        "case_key": {
          "type": "string",
          "enum": [
            "required_lane_with_value",
            "required_lane_marked_missing"
          ]
        },
        "input_contract_references": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "canonical_semantic_fact": {
          "$ref": "#/$defs/presenceOnlySemanticFact"
        }
      }
    }
  }
}
