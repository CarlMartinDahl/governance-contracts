{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governance-contracts.invalid/schemas/cmd-export-package-projection.json",
  "title": "CMD_PROFILE Export Package Projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "jurisdiction_profile_key",
    "export_version",
    "dossier_fingerprint",
    "canonical_source",
    "profile_dossier_snapshot",
    "generated_at",
    "manifest",
    "snapshot_status"
  ],
  "properties": {
    "jurisdiction_profile_key": {
      "type": "string",
      "const": "CMD_PROFILE"
    },
    "export_version": {
      "type": "string",
      "minLength": 1
    },
    "dossier_fingerprint": {
      "type": "string",
      "minLength": 1
    },
    "canonical_source": {
      "$ref": "https://governance-contracts.invalid/schemas/cmd-export-package.json#/$defs/exportPackageCanonicalSource"
    },
    "profile_dossier_snapshot": {
      "$ref": "https://governance-contracts.invalid/schemas/cmd-profile-dossier-snapshot.json"
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "manifest": {
      "$ref": "https://governance-contracts.invalid/schemas/cmd-export-package.json#/$defs/exportPackageManifest"
    },
    "snapshot_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "snapshot_export_version_found",
        "current_export_version",
        "snapshot_is_current"
      ],
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "persisted-current",
            "persisted-stale"
          ]
        },
        "snapshot_export_version_found": {
          "type": "string",
          "minLength": 1
        },
        "current_export_version": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_is_current": {
          "type": "boolean"
        }
      }
    }
  }
}
