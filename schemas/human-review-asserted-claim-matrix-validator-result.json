{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governance-contracts.invalid/schemas/human-review-asserted-claim-matrix-validator-result.json",
  "title": "Human Review Asserted Claim Matrix Validator Result Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "valid",
    "contractKind",
    "version",
    "errors"
  ],
  "properties": {
    "valid": {
      "type": "boolean"
    },
    "contractKind": {
      "type": "string",
      "const": "HUMAN_REVIEW_ASSERTED_CLAIM_MATRIX_VALIDATOR_BOUNDARY"
    },
    "version": {
      "type": "string",
      "const": "1.0.0"
    },
    "errors": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "path"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        },
        "oneOf": [
          {
            "properties": {
              "code": {
                "const": "required_field_missing"
              },
              "path": {
                "oneOf": [
                  {
                    "enum": [
                      "$.contract_id",
                      "$.contract_version",
                      "$.packet_ref",
                      "$.claims"
                    ]
                  },
                  {
                    "pattern": "^\\$\\.claims\\[(0|[1-9][0-9]*)\\]\\.(claim_ref|review_state|asserted_claim_text|supplied_material_observation_text|source_refs|chronology_entry_refs)$"
                  }
                ]
              }
            }
          },
          {
            "properties": {
              "code": {
                "const": "unexpected_field"
              },
              "path": {
                "oneOf": [
                  {
                    "const": "$"
                  },
                  {
                    "pattern": "^\\$\\.claims\\[(0|[1-9][0-9]*)\\]$"
                  }
                ]
              }
            }
          },
          {
            "properties": {
              "code": {
                "const": "invalid_field_type"
              },
              "path": {
                "oneOf": [
                  {
                    "enum": [
                      "$",
                      "$.contract_id",
                      "$.contract_version",
                      "$.packet_ref",
                      "$.claims"
                    ]
                  },
                  {
                    "pattern": "^\\$\\.claims\\[(0|[1-9][0-9]*)\\]$"
                  },
                  {
                    "pattern": "^\\$\\.claims\\[(0|[1-9][0-9]*)\\]\\.(claim_ref|review_state|asserted_claim_text|supplied_material_observation_text|source_refs|chronology_entry_refs)$"
                  },
                  {
                    "pattern": "^\\$\\.claims\\[(0|[1-9][0-9]*)\\]\\.(source_refs|chronology_entry_refs)\\[(0|[1-9][0-9]*)\\]$"
                  }
                ]
              }
            }
          },
          {
            "properties": {
              "code": {
                "const": "invalid_field_value"
              },
              "path": {
                "oneOf": [
                  {
                    "enum": [
                      "$.contract_id",
                      "$.contract_version",
                      "$.packet_ref"
                    ]
                  },
                  {
                    "pattern": "^\\$\\.claims\\[(0|[1-9][0-9]*)\\]\\.(claim_ref|review_state|asserted_claim_text|supplied_material_observation_text)$"
                  },
                  {
                    "pattern": "^\\$\\.claims\\[(0|[1-9][0-9]*)\\]\\.(source_refs|chronology_entry_refs)$"
                  },
                  {
                    "pattern": "^\\$\\.claims\\[(0|[1-9][0-9]*)\\]\\.(source_refs|chronology_entry_refs)\\[(0|[1-9][0-9]*)\\]$"
                  }
                ]
              }
            }
          },
          {
            "properties": {
              "code": {
                "const": "state_observation_mismatch"
              },
              "path": {
                "pattern": "^\\$\\.claims\\[(0|[1-9][0-9]*)\\]\\.supplied_material_observation_text$"
              }
            }
          },
          {
            "properties": {
              "code": {
                "const": "duplicate_claim_ref"
              },
              "path": {
                "pattern": "^\\$\\.claims\\[(0|[1-9][0-9]*)\\]\\.claim_ref$"
              }
            }
          },
          {
            "properties": {
              "code": {
                "const": "duplicate_source_ref"
              },
              "path": {
                "pattern": "^\\$\\.claims\\[(0|[1-9][0-9]*)\\]\\.source_refs\\[(0|[1-9][0-9]*)\\]$"
              }
            }
          },
          {
            "properties": {
              "code": {
                "const": "duplicate_chronology_entry_ref"
              },
              "path": {
                "pattern": "^\\$\\.claims\\[(0|[1-9][0-9]*)\\]\\.chronology_entry_refs\\[(0|[1-9][0-9]*)\\]$"
              }
            }
          }
        ]
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "valid": {
          "const": true
        },
        "errors": {
          "maxItems": 0
        }
      }
    },
    {
      "properties": {
        "valid": {
          "const": false
        },
        "errors": {
          "minItems": 1
        }
      }
    }
  ]
}
