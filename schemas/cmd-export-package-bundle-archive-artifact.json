{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governance-contracts.invalid/schemas/cmd-export-package-bundle-archive-artifact.json",
  "title": "CMD_PROFILE Final Export Bundle Archive Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "filename",
    "content_type",
    "encoding",
    "body_base64",
    "package_version",
    "bundle_manifest_fingerprint"
  ],
  "properties": {
    "artifact_type": {
      "type": "string",
      "const": "export-package-bundle-archive"
    },
    "filename": {
      "type": "string",
      "minLength": 1
    },
    "content_type": {
      "type": "string",
      "const": "application/zip"
    },
    "encoding": {
      "type": "string",
      "const": "base64"
    },
    "body_base64": {
      "type": "string",
      "minLength": 1
    },
    "package_version": {
      "type": "string",
      "minLength": 1
    },
    "bundle_manifest_fingerprint": {
      "type": "string",
      "minLength": 1
    }
  }
}
