{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governance-contracts.invalid/schemas/swe-bodelning-export-package-json-artifact.json",
  "title": "SWE_BODELNING Export Package JSON Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "filename",
    "content_type",
    "encoding",
    "body_utf8"
  ],
  "properties": {
    "artifact_type": {
      "type": "string",
      "const": "export-package-json"
    },
    "filename": {
      "type": "string",
      "minLength": 1
    },
    "content_type": {
      "type": "string",
      "const": "application/json"
    },
    "encoding": {
      "type": "string",
      "const": "utf-8"
    },
    "body_utf8": {
      "type": "string",
      "minLength": 1
    }
  }
}
