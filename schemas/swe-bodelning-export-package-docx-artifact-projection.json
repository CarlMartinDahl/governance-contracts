{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governance-contracts.invalid/schemas/swe-bodelning-export-package-docx-artifact-projection.json",
  "title": "SWE_BODELNING Export Package DOCX Artifact Projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "filename",
    "content_type",
    "encoding",
    "body_base64",
    "snapshot_status"
  ],
  "properties": {
    "artifact_type": {
      "type": "string",
      "const": "export-package-docx"
    },
    "filename": {
      "type": "string",
      "minLength": 1
    },
    "content_type": {
      "type": "string",
      "const": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
    },
    "encoding": {
      "type": "string",
      "const": "base64"
    },
    "body_base64": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "snapshot_export_version_found",
        "current_export_version",
        "snapshot_is_current"
      ],
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "persisted-current",
            "persisted-stale"
          ]
        },
        "snapshot_export_version_found": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "current_export_version": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_is_current": {
          "type": "boolean"
        }
      }
    }
  }
}
