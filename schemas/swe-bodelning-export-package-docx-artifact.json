{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governance-contracts.invalid/schemas/swe-bodelning-export-package-docx-artifact.json",
  "title": "SWE_BODELNING Export Package DOCX Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "filename",
    "content_type",
    "encoding",
    "body_base64"
  ],
  "properties": {
    "artifact_type": {
      "type": "string",
      "const": "export-package-docx"
    },
    "filename": {
      "type": "string",
      "minLength": 1
    },
    "content_type": {
      "type": "string",
      "const": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
    },
    "encoding": {
      "type": "string",
      "const": "base64"
    },
    "body_base64": {
      "type": "string",
      "minLength": 1
    }
  }
}
