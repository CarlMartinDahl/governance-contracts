{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governance-contracts.invalid/schemas/traceability-model.json",
  "title": "Traceability Model Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "input_references",
    "documented_rule_references",
    "canonical_output_references"
  ],
  "properties": {
    "input_references": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "documented_rule_references": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "canonical_output_references": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "change_causes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "changed_input",
          "changed_support",
          "changed_rule"
        ]
      }
    }
  }
}
