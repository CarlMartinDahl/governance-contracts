{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governance-contracts.invalid/schemas/human-review-no-conclusion-notice.json",
  "title": "Human Review No-Conclusion Notice Contract Scaffold",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "contract_version",
    "packet_ref",
    "notices"
  ],
  "properties": {
    "contract_id": {
      "type": "string",
      "const": "human_review.no_conclusion_notice"
    },
    "contract_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "packet_ref": {
      "type": "string",
      "pattern": "^pkt_[a-z0-9][a-z0-9_-]{0,59}$"
    },
    "notices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/noticeRow"
      }
    }
  },
  "$defs": {
    "noticeRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "notice_ref",
        "declaration_origin",
        "notice_code",
        "notice_text",
        "source_refs",
        "chronology_entry_refs",
        "claim_refs",
        "gap_refs",
        "question_refs"
      ],
      "properties": {
        "notice_ref": {
          "type": "string",
          "pattern": "^ncn_[a-z0-9][a-z0-9_-]{0,59}$"
        },
        "declaration_origin": {
          "type": "string",
          "const": "BOUNDARY_DECLARED"
        },
        "notice_code": {
          "type": "string",
          "const": "NO_MODEL_CONCLUSION_UNDER_CURRENT_BOUNDARY"
        },
        "notice_text": {
          "type": "string",
          "const": "No model conclusion is established under the current boundary."
        },
        "source_refs": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^src_[a-z0-9][a-z0-9_-]{0,59}$"
          }
        },
        "chronology_entry_refs": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^chr_[a-z0-9][a-z0-9_-]{0,59}$"
          }
        },
        "claim_refs": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^clm_[a-z0-9][a-z0-9_-]{0,59}$"
          }
        },
        "gap_refs": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^gap_[a-z0-9][a-z0-9_-]{0,59}$"
          }
        },
        "question_refs": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^qst_[a-z0-9][a-z0-9_-]{0,59}$"
          }
        }
      },
      "anyOf": [
        {
          "properties": {
            "source_refs": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "chronology_entry_refs": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "claim_refs": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "gap_refs": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "question_refs": {
              "minItems": 1
            }
          }
        }
      ]
    }
  }
}
