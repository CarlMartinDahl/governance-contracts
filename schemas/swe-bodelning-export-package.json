{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governance-contracts.invalid/schemas/swe-bodelning-export-package.json",
  "title": "SWE_BODELNING Export Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "jurisdiction_profile_key",
    "export_version",
    "dossier_fingerprint",
    "canonical_source",
    "profile_dossier_snapshot",
    "generated_at",
    "manifest"
  ],
  "properties": {
    "jurisdiction_profile_key": {
      "type": "string",
      "const": "SWE_BODELNING"
    },
    "export_version": {
      "type": "string",
      "minLength": 1
    },
    "dossier_fingerprint": {
      "type": "string",
      "minLength": 1
    },
    "canonical_source": {
      "$ref": "https://governance-contracts.invalid/schemas/swe-bodelning-profile-dossier-snapshot.json#/$defs/canonicalSource"
    },
    "profile_dossier_snapshot": {
      "$ref": "https://governance-contracts.invalid/schemas/swe-bodelning-profile-dossier-snapshot.json"
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "manifest": {
      "$ref": "#/$defs/exportPackageManifest"
    }
  },
  "$defs": {
    "exportPackageManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "included_top_level_artifacts"
      ],
      "properties": {
        "included_top_level_artifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "canonical_source",
              "profile_dossier_snapshot"
            ]
          },
          "uniqueItems": true,
          "minItems": 1
        }
      }
    }
  }
}
